    %% ===================== CÁC BẢNG ĐẶT VÉ =====================
    ticket {
        bigint ticket_id PK "UNIQUE (ticket_id, trip_id)"
        bigint trip_id FK "NOT NULL; phơi của vé"
        varchar ticket_no "NOT NULL; SGCD-0001 từ ticket_no_seq; UNIQUE (ticket_no, trip_id) WHERE status IN (hold, sold)"
        varchar status "NOT NULL; hold | sold | cancelled | transferred"
        varchar channel "NOT NULL DEFAULT counter; counter | pickup (từ Rước liền); online = ĐỂ SAU (B25, quyết định 16), bản nội bộ chưa dùng"
        timestamptz hold_expires_at "ĐỂ SAU (online, quyết định 16): chỉ vé online chưa thanh toán đủ; quá hạn thì tự nhả ghế (B25); NULL với vé quầy / đại lý (không hết hạn, F12)"
        bigint group_ticket_id FK "mã nhóm: các vé cùng giá trị này là một nhóm, KHÔNG phân biệt vé gốc và vé đặt thêm; vé đầu tiên của nhóm cũng mang giá trị này (= ticket_id của chính nó); FK ghép (group_ticket_id, trip_id) -> ticket(ticket_id, trip_id) để nhóm chỉ nằm trong 1 phơi; trigger: chỉ trỏ vào vé có group_ticket_id = chính nó (B8, B27, B30)"
        bigint transferred_from_ticket_id FK "vé nguồn khi chuyển ghế / đặt lại / đổi chỉ định"
        bigint customer_id FK "khách hàng, suy từ SĐT chính"
        varchar customer_name "NULL được: tên KHÔNG bắt buộc mặc định, bật bắt buộc bằng cài đặt ticket_require_name; vé cũ có thể trống (B4, B29); app: customerName"
        varchar phone "NULL được ở DB (vé cũ không có SĐT); SĐT chính BẮT BUỘC khi đặt / bán vé mới theo cài đặt ticket_require_phone, mặc định bật (B4, B29); chuẩn hoá; có index"
        text phone_extra "SĐT phụ (text[])"
        varchar guest_type "NOT NULL; Khách trạm | Trung chuyển | Rước đường; app: guestType"
        varchar first_stop "NOT NULL; chữ để hiển thị / in vé, tra giá dùng from_station_id; app: firstStop"
        varchar last_stop "NOT NULL; chữ để hiển thị / in vé, tra giá dùng to_station_id; app: lastStop"
        bigint from_station_id FK "trạm đi lúc bán, tra giá; app: fromStationId"
        bigint to_station_id FK "trạm đến lúc bán; app: toStationId"
        text pickup_address "app: transshipStation / transship / pickupAddress"
        text dropoff_address "app: arrivalTransfer / dropoffAddress"
        boolean has_luggage "NOT NULL DEFAULT FALSE; app: hasLuggage"
        text luggage_note "app: luggageNote"
        text note "app: note"
        int unit_price "NOT NULL >= 0; giá 1 ghế; app: price"
        boolean is_double_seat "NOT NULL DEFAULT FALSE; ghế đôi vẫn là 1 ghế"
        text zero_price_reason "bắt buộc khi unit_price = 0"
        timestamptz sold_at "NOT NULL khi sold"
        bigint agent_id FK "đại lý; app: agentId"
        varchar agent_name "chụp tên đại lý; app: agentName"
        decimal agent_commission_rate "chụp % hoa hồng của đại lý lúc bán (B24); NULL = không có đại lý hoặc dữ liệu cũ"
        bigint selling_station_id FK "NOT NULL; trạm chịu doanh số; app: sellingStation"
        uuid sold_by FK "NOT NULL; người chịu doanh số / thu tiền; app: staff"
        bigint booked_station_id FK "NOT NULL; trạm người đặt; app: bookedStation"
        uuid booked_by FK "NOT NULL; người đặt; app: bookedBy"
        varchar sold_phase "NOT NULL; PRE_DEPART | POST_DEPART; app: soldPhase"
        bigint reopen_event_id FK "vé tạo lúc Re-open; app: reopenEventId"
        bigint settled_reopen_event_id FK "thu tiền lúc Re-open; app: settledReopenEventId"
        timestamptz created_at "NOT NULL; dữ liệu cũ: actionTime sớm nhất của vé, thiếu thì giờ khởi hành của phơi"
        timestamptz updated_at "NOT NULL; app: actionTime"
    }

    trip_seat {
        bigint trip_seat_id PK "bảng đầy đủ ở phoi-xe-erd.mmd"
        bigint trip_id FK "NOT NULL"
        varchar seat_code "UNIQUE (trip_id, seat_code); app: code"
        varchar floor_type "down | up | extra | sub"
        boolean is_hidden "ghế ẩn của loại xe"
        int price "giá niêm yết ghế TRỐNG"
        bigint ticket_id FK "THÊM: NULL = ghế trống; FK ghép (ticket_id, trip_id)"
        text qr_text "THÊM: NULL được; nội dung mã QR của TỜ VÉ in cho ghế này, lưu dạng CHỮ, chỉ có khi ghế đang giữ vé (ticket_id khác NULL), xóa khi ghế trống; nội dung do chủ tự điền, hiển thị / in = vẽ QR từ chữ, KHÔNG lưu ảnh (B31)"
    }

    seat_cancellation {
        bigint cancellation_id PK "app: cancelledSeats[].id"
        bigint ticket_id FK "NOT NULL; vé gốc của ghế hủy"
        bigint trip_id FK "NOT NULL"
        varchar seat_code "NOT NULL; mỗi ghế hủy 1 dòng; app: code"
        varchar prev_status "hold | sold; chỉ hold mới đặt lại được; app: prevState"
        int unit_price "NOT NULL; giá ghế lúc hủy; app: price"
        text reason "NOT NULL; lý do hủy"
        timestamptz cancelled_at "NOT NULL; app: cancelledAt"
        uuid cancelled_by FK "users.user_id; app: cancelStaff"
        bigint restored_ticket_id FK "UNIQUE; vé mới khi đặt lại; app: restoredTo*"
    }

    ticket_payment {
        bigint payment_id PK "B23; dòng chỉ thêm, không sửa, không xóa"
        bigint ticket_id FK "NOT NULL"
        varchar kind "NOT NULL; deposit | payment | refund | transfer_out | transfer_in"
        int amount "NOT NULL > 0; chiều tiền do kind quyết định"
        varchar method "Tiền mặt | Chuyển khoản; NOT NULL với deposit / payment / refund, NULL với transfer_*"
        text reason "bắt buộc khi refund; ghi cách nhân viên tính số hoàn"
        varchar reference "mã giao dịch ngân hàng / cổng thanh toán, tùy chọn"
        bigint counterpart_payment_id FK "UNIQUE; nối cặp transfer_out / transfer_in; FK DEFERRABLE INITIALLY DEFERRED vì ghi cả cặp trong 1 giao dịch (B27)"
        bigint station_id FK "NOT NULL; trạm của người ghi"
        uuid created_by FK "NOT NULL; người thu / hoàn"
        bigint reopen_event_id FK "lần Re-open đang mở lúc ghi, NULL nếu không"
        timestamptz paid_at "NOT NULL"
    }

    customer {
        bigint customer_id PK
        varchar customer_code UK "KH0001..; từ hn_admin_customer_codes_v1"
        varchar phone UK "SĐT chính chuẩn hoá"
        varchar full_name "tên gần nhất"
        timestamptz created_at "NOT NULL"
    }

    agent {
        bigint agent_id PK "app: AgentStore id"
        varchar code UK "DL001.."
        varchar name UK
        varchar phone
        text note
        decimal commission_rate "NOT NULL DEFAULT 0, 0..100; % hoa hồng, admin cài ở màn Đại lý, mỗi đại lý một số (B24)"
    }

    employee_stations {
        bigint id PK "đầy đủ ở so-do-er-nhan-su-v3.1"
        bigint employee_id FK
        bigint station_id FK
        boolean is_primary "nguồn của ticket.selling_station_id"
        timestamptz valid_to "NULL = đang áp dụng"
    }

    trip {
        bigint trip_id PK "KHUNG, đầy đủ ở phoi-xe-erd.mmd"
    }

    trip_reopen_event {
        bigint reopen_event_id PK "KHUNG, đầy đủ ở phoi-xe-erd.mmd"
    }

    station {
        bigint station_id PK "KHUNG; cần dòng hệ thống Admin"
    }

    users {
        uuid user_id PK "KHUNG, so-do-er-nhan-su-v3.1"
    }

    employees {
        bigint id PK "KHUNG, so-do-er-nhan-su-v3.1"
    }

    activity_logs {
        bigint id PK "KHUNG, so-do-er-nhat-ky-v3.1"
        text entity_type "ticket, pickup_request..."
        text entity_id
        text action "book, sell, edit, cancel_seat, refund, transfer, restore..."
    }

    employee_types {
        smallint id PK "KHUNG, so-do-er-nhan-su-v3.1; loại nhân viên (quyền gán theo loại, không gán riêng từng người)"
    }

    employee_type_permissions {
        smallint employee_type_id PK, FK "KHUNG, so-do-er-nhan-su-v3.1; do HR cấp, migration KHÔNG seed (B16)"
        text permission_key PK, FK "book_ticket, sell_ticket, change_price, transship_pickup, transship_assign, print_transship_ticket, assign_depart_reopen, edit_after_departure, view_tickets, view_customers... Nguồn DUY NHẤT của quyền; các hàm B26 kiểm bằng bảng này"
    }

    permissions {
        text key PK "KHUNG, so-do-er-nhan-su-v3.1; danh mục khóa chức năng (nhóm Vé & ghế)"
    }

    employee_types ||--o{ employee_type_permissions : "cấp quyền cho loại (có thể 0 dòng)"
    permissions ||--o{ employee_type_permissions : "khóa được cấp cho loại"
    employee_types ||--o{ employees : "loại nhân viên -> quyền dùng các hàm đặt / bán / hủy / chuyển / hoàn (B26)"

