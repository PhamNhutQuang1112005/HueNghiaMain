    %% TRUNG CHUYỂN / RƯỚC LIỀN (GIAI ĐOẠN 2) — tách ra từ docs/dat-ve-erd.mmd ngày 28/10/2026 (quyết định 21). Bản đặt + bán vé (giai đoạn 1) ở dat-ve-erd.mmd.
    %% BẢNG: pickup_request (hàng chờ khách Rước liền), shuttle_assignment (chặng đón / trả của vé hoặc của khách đang chờ). ticket, station, users, employees, vehicle chỉ là KHUNG để vẽ quan hệ.
    %% ĐIỀU KIỆN BẮT BUỘC TỪ GIAI ĐOẠN 1: chép lại bên dưới ở mục ĐIỂM NỐI (B28 trong dat-ve-erd.mmd). Vé sinh từ Rước liền phải đi qua đúng luật đặt / bán vé.

    pickup_request |o--o| ticket : "vé đã bán khi chỉ định xe (pickup_request.ticket_id); NULL = còn trong hàng chờ"
    users |o--o{ pickup_request : "người nhập khách Rước liền"
    station |o--o{ pickup_request : "trạm nơi nhập khách"
    ticket |o--o{ shuttle_assignment : "chặng đón / trả của vé (tối đa 1 dòng mỗi chặng)"
    pickup_request |o--o{ shuttle_assignment : "chặng đón của khách Rước liền còn trong hàng chờ"
    employees |o--o{ shuttle_assignment : "tài xế trung chuyển (crew_role = shuttle_driver)"
    vehicle |o--o{ shuttle_assignment : "xe trung chuyển (scope shuttle)"
    users |o--o{ shuttle_assignment : "người cập nhật"
    ticket |o--o{ ticket : "vé mới khi đổi chỉ định (transferred_from_ticket_id); pickup_request.ticket_id luôn trỏ vé mới nhất"
    station ||--o{ ticket : "trạm bán / chịu doanh số (selling_station_id)"
    users ||--o{ ticket : "người bán / chịu doanh số (sold_by)"
    employee_types ||--o{ employee_type_permissions : "cấp quyền cho loại (có thể 0 dòng)"
    permissions ||--o{ employee_type_permissions : "khóa được cấp cho loại"
    employee_types ||--o{ employees : "loại nhân viên -> quyền trung chuyển"

    pickup_request {
        bigint pickup_request_id PK "GIAI ĐOẠN 2 (trung chuyển, quyết định 18); app: pickupPassengers[].id"
        varchar customer_name "NOT NULL; app: name"
        varchar phone "NOT NULL; SĐT chính chuẩn hoá (số đầu của collectPhoneValues)"
        text phone_extra "SĐT phụ (text[]); modal Rước liền cho nhập nhiều số, chuyển sang ticket.phone_extra khi chỉ định xe"
        int ticket_count "NOT NULL DEFAULT 1; app: ticketCount"
        varchar from_place "app: fromStation"
        text pickup_address "app: fromTransfer; '—' -> NULL"
        varchar to_place "app: toStation"
        text dropoff_address "app: toTransfer; '—' -> NULL"
        text note "app: note"
        bigint ticket_id FK "vé đã bán khi chỉ định xe; NULL = đang chờ; app: assigned"
        bigint station_id FK "trạm nhập khách"
        uuid created_by FK "users.user_id; ghi cả khi nhập từ Admin > Trung chuyển"
        date pickup_date "NOT NULL; ngày rước; app: date (Admin ghi, modal ticketstaff không ghi); mặc định ngày đang chọn ở danh sách Rước liền"
        timestamptz printed_at "giờ in danh sách Rước; app: printedAt (tính năng in chưa làm)"
        timestamptz created_at "app: createdAt"
    }

    shuttle_assignment {
        bigint assignment_id PK "GIAI ĐOẠN 2 (trung chuyển, quyết định 18); app: hn_shuttle_driver_assign_v1"
        bigint ticket_id FK "đúng 1 trong ticket_id / pickup_request_id (CHECK num_nonnulls = 1); UNIQUE (ticket_id, leg) khi ticket_id có giá trị (B27)"
        bigint pickup_request_id FK "khách Rước liền còn chờ; UNIQUE (pickup_request_id, leg) khi có giá trị (B27)"
        varchar leg "NOT NULL; pickup | dropoff; app: hậu tố _don / _tra"
        bigint driver_id FK "employees, crew_role = shuttle_driver; app: driverName / driverPhone"
        bigint vehicle_id FK "xe scope shuttle; app: driverPlate"
        varchar status "NOT NULL DEFAULT waiting; waiting | enroute | onboard | issue"
        text issue_reason "bắt buộc khi issue; app: note"
        text driver_note "app: driverNote"
        text office_note "app: transshipPickupNote / transshipDropoffNote"
        timestamptz updated_at "NOT NULL"
        uuid updated_by FK "users.user_id"
    }

    ticket {
        bigint ticket_id PK "KHUNG, đầy đủ ở dat-ve-erd.mmd"
        bigint trip_id FK "phơi của vé"
        varchar ticket_no "SGCD-0001 từ ticket_no_seq"
        varchar status "hold | sold | cancelled | transferred; vé từ Rước liền sinh ra là sold"
        varchar channel "counter | pickup; Rước liền chỉ định xe = pickup"
        varchar guest_type "Rước liền chỉ định xe = Trung chuyển"
        varchar first_stop "trạm đi của KHÁCH"
        varchar last_stop "trạm đến của KHÁCH"
        bigint from_station_id FK "tra giá theo trạm khách"
        bigint to_station_id FK "tra giá theo trạm khách"
        text pickup_address "channel = pickup được để trống"
        text dropoff_address "channel = pickup được để trống"
        int unit_price "giá 1 ghế; 0đ cần change_price + lý do"
        bigint transferred_from_ticket_id FK "vé cũ khi đổi chỉ định"
        bigint selling_station_id FK "NOT NULL"
        uuid sold_by FK "NOT NULL"
    }

    station {
        bigint station_id PK "KHUNG"
    }

    users {
        uuid user_id PK "KHUNG"
    }

    employees {
        bigint id PK "KHUNG; tài xế trung chuyển = crew_role shuttle_driver"
    }

    vehicle {
        bigint vehicle_id PK "KHUNG; xe scope shuttle"
    }

    employee_types {
        smallint id PK "KHUNG, so-do-er-nhan-su-v3.1"
    }

    employee_type_permissions {
        smallint employee_type_id PK, FK "KHUNG"
        text permission_key PK, FK "transship_pickup, transship_assign, print_transship_ticket, sell_ticket (chỉ định xe); do HR cấp, không seed"
    }

    permissions {
        text key PK "KHUNG"
    }

