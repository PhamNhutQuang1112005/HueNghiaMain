#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR/Redesign the User Interface"

# Development mode preserves inline sourcemaps for cached preview diagnostics.
pnpm run build --mode development
[[ -d "dist" ]] || {
  echo "Expected build output at dist" >&2
  exit 1
}
figma make deploy-preview --build-dir "dist"
