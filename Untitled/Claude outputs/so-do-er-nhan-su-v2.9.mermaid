    %%   shifts: UNIQUE (user_id, function_key) WHERE status = open; (function_key, closed_at); (opened_at) WHERE status = open (Tab 7); (user_id, closed_at) cho cổng lịch ca;
    %%     (station_id) cho lọc theo trạm;
    %%   shift_reports (shift_id, version) UNIQUE; (function_key, closed_at); (station_id, closed_at);
    %%   module phơi: trip_manifests (driver_id), trip_manifests (helper_id).

    permission_groups {
        text key PK "mã nhóm, vd ticket_seat, hr_system"
        text label "tên nhóm hiện trên form phân quyền của loại, vd Vé & ghế"
        int sort_order "thứ tự nhóm trên form"
    }

    work_functions {
        text key PK "call_center, ticket_office, cargo_receive, cargo_delivery, shuttle_driver, shuttle_dispatch; admin gốc quản lý"
        text label "Tổng đài, Phòng vé, Nhận hàng, Giao hàng, Tài xế trung chuyển, Điều hành trung chuyển"
        boolean has_shift "true = phải có ca khi thao tác và kết ca; shuttle_dispatch luôn false (không nhận tiền, không kết ca)"
        boolean auto_open "true = API tự mở ca ở thao tác đầu tiên (chỉ shuttle_driver); CHECK (has_shift OR NOT auto_open)"
        int sort_order
        boolean is_active "false = ngừng dùng, vẫn giữ lịch sử"
    }

    permissions {
        text key PK "mã quyền, vd book_ticket, approve_devices; app và API kiểm bằng mã này; key ngoài danh mục khởi tạo thêm khi code tới; view_all_stations = xem dữ liệu mọi trạm (quyền phạm vi, mọi loại nhóm HR có)"
        text group_key FK "NOT NULL; nhóm của quyền"
        text function_key FK "null được; chức năng mà quyền này thuộc về (work_functions.key); null = quyền chung; mỗi quyền đúng MỘT chức năng hoặc NULL"
        text label "nhãn trên ô tick, vd Đặt vé; approve_devices có nhãn Duyệt đăng nhập và chặn thiết bị"
        text description "giải thích thêm, null được"
        boolean protects_holder "true = người có quyền này thuộc nhóm được bảo vệ, chỉ admin gốc sửa (manage_hr, manage_accounts); mặc định false"
        int sort_order "thứ tự trong nhóm"
    }

    work_kinds {
        text key PK "mã nhóm công việc, chữ thường; CHECK ^[a-z][a-z0-9_]{1,31}$; không sửa sau khi tạo; seed 8 nhóm gốc: driver, shuttle_driver, helper, call_center, ticket_office, cargo, shuttle_dispatch, staff; admin gốc thêm nhóm mới (v2.9, thay CHECK cứng work_kind)"
        text label UK "tên nhóm hiển thị, vd Tài xế tuyến, Khác"
        boolean is_self "true = người thuộc nhóm chỉ xem dữ liệu của CHÍNH MÌNH, không có khu vực (driver, shuttle_driver, helper)"
        boolean requires_license "true = bắt buộc hạng và hạn bằng lái (driver, shuttle_driver); trigger T1 đọc cột này"
        boolean is_active "false = ngừng dùng cho loại mới, vẫn giữ lịch sử"
        boolean is_system "true = nhóm gốc, không xóa, không đổi mã; vẫn sửa được tên, hai cờ, ghi chú"
        int sort_order
        text note
        timestamptz created_at
        uuid created_by FK "admin gốc"
        timestamptz updated_at
        uuid updated_by FK
    }

    employee_types {
        smallint id PK
        text code UK "mã hiển thị ở cột Mã; CHECK ^[a-z][a-z0-9_]{1,31}$; NOT NULL; bắt đầu bằng mã nhóm công việc (quy tắc o); không sửa sau khi tạo (trigger T6); không dùng để rẽ logic"
        text name UK "tên loại hiển thị, vd Tài xế tuyến; mã nhân viên không phụ thuộc loại; đây cũng là nhãn vai trò trên trang Tài khoản"
        text work_kind FK "NOT NULL; trỏ work_kinds.key; chỉ đổi khi loại chưa có NV (trigger T2); KHÔNG dùng để chia tab kết ca; v2.9 KHÔNG còn cột data_scope và login_by_schedule"
        text redirect_page "trang vào sau đăng nhập, vd taixe.html, cargo/cargo.html, ticketstaff.html; mặc định theo nhóm công việc; nhóm HR luôn vào admin.html (ĐIỂM CẦN CHỦ XÁC NHẬN)"
        boolean is_active "false = ngừng dùng cho NV mới, vẫn giữ lịch sử; thay nút Xóa"
        text note
        timestamptz created_at
        uuid created_by FK "admin gốc hoặc HR có manage_hr (loại thường)"
        timestamptz updated_at
        uuid updated_by FK
    }

    employee_type_permissions {
        smallint employee_type_id PK, FK
        text permission_key PK, FK "có dòng = loại được cấp quyền; không dòng nào = chưa gán quyền; chỉ admin gốc sửa; NGUỒN DUY NHẤT của quyền người dùng"
    }

    employee_type_grantable_permissions {
        smallint employee_type_id PK, FK "loại của NGƯỜI CẤP, vd Nhân sự"
        text permission_key PK, FK "quyền mà người thuộc loại này được phép cấp cho người khác (qua việc gán hoặc đổi loại); không liên quan quyền bản thân có; không chứa quyền protects_holder; chỉ admin gốc sửa"
    }

    employment_statuses {
        text code PK "working, suspended, left hoặc mã admin gốc thêm"
        text name "tên hiển thị, vd Đang làm việc, Tạm ngưng, Nghỉ việc"
        boolean locks_account "true = NV ở trạng thái này không đăng nhập được; working luôn false, left luôn true (CHECK); chỉ admin gốc đổi"
        boolean is_system "true = trạng thái hệ thống, không xóa, không đổi mã"
        int sort_order
        text note
    }

    shift_templates {
        smallint id PK "ca mẫu của LỊCH CA đăng nhập, không phải ca thực tế (shifts)"
        text code UK "CHECK ^[a-z][a-z0-9_]{1,31}$; NOT NULL; không sửa sau khi tạo (trigger T7, v2.8); chỉ để hiển thị và tìm kiếm"
        text name UK "vd Ca sáng, Ca chiều, Ca đêm"
        time start_time "giờ bắt đầu theo múi giờ login_schedule_timezone"
        time end_time "giờ kết thúc; không lớn hơn start_time nghĩa là qua đêm"
        boolean crosses_midnight "CHECK (crosses_midnight = (end_time <= start_time)); ca qua đêm tính theo ngày BẮT ĐẦU"
        boolean is_active "false = ngừng dùng cho lịch mới, lịch cũ vẫn giữ"
        text note
        timestamptz created_at
        uuid created_by FK "admin gốc"
        timestamptz updated_at
        uuid updated_by FK
    }

    employees {
        bigint id PK
        smallint employee_type_id FK "NOT NULL; loại NV hiện tại, đổi được (quyền đổi theo, mã NV không đổi, ghi employee_type_history); đổi trạm thì KHÔNG đổi cột này nên quyền giữ nguyên; đổi loại bị chặn khi còn ca mở"
        text employee_code UK "mã NV hiển thị; CHECK ^NV[0-9]{5,}$; trigger lấy từ employee_code_seq nếu NULL; KHÔNG sửa sau khi tạo; bảng khác nối bằng id"
        text full_name "NOT NULL; họ tên hiển thị trên trang Tài khoản (chỉ đọc ở đó)"
        text phone_number "SĐT liên hệ; không UNIQUE, có index để cảnh báo trùng"
        citext email "null được"
        text address "null được"
        text license "hạng bằng lái, text tự do (hạng cũ hoặc mới); bắt buộc khi work_kinds.requires_license của nhóm loại hiện tại là true (trigger T1)"
        date license_expiry "hạn bằng lái; bắt buộc cùng điều kiện với license; null = không theo dõi"
        date hired_date "ngày vào làm gần nhất; vào làm lại thì cập nhật, lịch sử nằm ở employee_status_history; CHECK (left_date IS NULL OR hired_date IS NULL OR left_date >= hired_date)"
        date left_date "có giá trị khi và chỉ khi status_code = left (CHECK)"
        text status_code FK "NOT NULL, mặc định working; đổi thì ghi employee_status_history"
        text note
        timestamptz created_at
        uuid created_by FK "NULL = nhập dữ liệu cũ"
        timestamptz updated_at
        uuid updated_by FK
    }

    employee_stations {
        bigint id PK
        bigint employee_id FK
        bigint station_id FK "trạm xe thật trong bảng station (không có trạm phụ); nhiều trạm được; bắt buộc có ít nhất 1 trạm xem được khi người có tài khoản, có chức năng phải mở ca, không thuộc nhóm is_self và không có view_all_stations (kể cả trạm lấy từ khu vực)"
        boolean is_primary "trạm làm việc chính của NHÂN VIÊN; mỗi NV tối đa 1 dòng đang áp dụng (UNIQUE WHERE valid_to IS NULL AND is_primary); có dòng thì phải có đúng 1 trạm chính"
        timestamptz valid_from "mốc bắt đầu làm ở trạm này; dữ liệu nghiệp vụ ghi từ mốc này chụp station_id mới"
        timestamptz valid_to "NULL = đang áp dụng; đổi trạm thì đóng dòng cũ ở đây, dữ liệu cũ vẫn thuộc trạm cũ; UNIQUE (employee_id, station_id) WHERE valid_to IS NULL"
        text reason "lý do đổi trạm, null được"
        uuid changed_by FK "NULL = nhập dữ liệu cũ"
    }

    employee_scope_regions {
        bigint id PK "khu vực được xem của nhân viên (có lịch sử); thay employee_scope_directions của v2.8"
        bigint employee_id FK
        bigint region_id FK "NV xem được dữ liệu mọi trạm active của khu vực này; trạm mới thêm vào khu vực tự thấy; không áp cho nhóm is_self (API lưu rỗng)"
        timestamptz valid_from
        timestamptz valid_to "NULL = đang áp dụng; UNIQUE (employee_id, region_id) WHERE valid_to IS NULL; tự đóng khi đổi sang loại thuộc nhóm is_self"
        text reason "null được"
        uuid changed_by FK "NULL = nhập dữ liệu cũ"
    }

    employee_shift_schedules {
        bigint id PK "lịch ca đăng nhập của nhân viên, mỗi dòng là một ca mẫu vào một thứ trong tuần"
        bigint employee_id FK
        smallint shift_template_id FK "ca mẫu áp dụng"
        smallint day_of_week "1 = thứ hai đến 7 = chủ nhật (CHECK 1 đến 7); là thứ của NGÀY BẮT ĐẦU ca, ca qua đêm cũng tính theo ngày bắt đầu"
        timestamptz valid_from
        timestamptz valid_to "NULL = đang áp dụng; UNIQUE (employee_id, shift_template_id, day_of_week) WHERE valid_to IS NULL; đóng cùng giao dịch khi nghỉ việc; API từ chối hai ca mẫu chồng giờ, tính cả vòng tuần (ca đêm chủ nhật tràn sang thứ hai)"
        text reason "null được"
        uuid changed_by FK "NULL = nhập dữ liệu cũ"
    }

    employee_type_history {
        bigint id PK
        bigint employee_id FK
        smallint employee_type_id FK "loại NV trong khoảng thời gian này"
        timestamptz valid_from
        timestamptz valid_to "NULL = đang áp dụng; mỗi NV đúng một dòng NULL"
        text reason "lấy từ app.change_reason; API bắt buộc khi đổi loại"
        uuid changed_by FK "lấy từ app.acting_user; NULL = tạo mới hoặc nhập dữ liệu cũ"
    }

    employee_status_history {
        bigint id PK
        bigint employee_id FK
        text status_code FK "trạng thái trong khoảng thời gian này"
        timestamptz valid_from
        timestamptz valid_to "NULL = đang áp dụng"
        text reason "lấy từ app.change_reason; API bắt buộc khi đổi sang trạng thái khác working"
        uuid changed_by FK
    }

    users {
        uuid user_id PK
        bigint employee_id FK, UK "NULL chỉ khi is_root; ngược lại NOT NULL (CHECK); nối SAU khi tạo nhân viên; không bao giờ đổi (trigger T3)"
        boolean is_root "admin gốc tạo bằng seed; mọi quyền; làm được chức năng nhân viên bằng ca riêng; miễn cổng lịch ca và miễn duyệt đăng nhập; không sửa qua giao diện, không đổi sau khi tạo (trigger T3); mặc định false"
        text display_name "tên hiển thị của admin gốc (không có hồ sơ NV); NOT NULL khi is_root, tài khoản khác để NULL"
        citext username UK "CHECK (username::text ~ ^[a-z0-9._-]{3,32}$) nên API đổi về chữ thường; CHỈ admin gốc đổi được (trigger T3 kiểm app.acting_user); đổi thì thu hồi phiên, ghi auth_events username_changed"
        text password_hash "bcrypt cost 12; không bao giờ hiển thị lại"
        boolean must_change_password "mặc định true; true sau khi tạo hoặc bị đặt lại bởi người khác; false khi tự đổi"
        timestamptz password_changed_at "lần đổi hoặc đặt lại mật khẩu gần nhất; NULL = chưa đổi từ lúc tạo"
        boolean is_active "khóa thủ công, độc lập với trạng thái nhân viên; không áp cho admin gốc qua giao diện"
        timestamptz locked_at "lúc khóa thủ công; NULL khi is_active = true"
        uuid locked_by FK "người khóa; NULL khi is_active = true"
        text lock_reason "lý do khóa; NOT NULL khi is_active = false; CHECK (is_active OR (locked_at IS NOT NULL AND lock_reason IS NOT NULL))"
        timestamptz last_login_at "lần đăng nhập thành công gần nhất (cập nhật ở bước 5 của luồng đăng nhập)"
        uuid created_by FK "admin gốc hoặc HR tạo; NULL = tạo bằng seed"
        timestamptz created_at
    }

    user_devices {
        uuid id PK "SỔ THIẾT BỊ: một dòng là một thiết bị của một tài khoản; KHÔNG mang trạng thái duyệt (duyệt nằm ở login_approvals); không xóa"
        uuid user_id FK "tài khoản sở hữu thiết bị; UNIQUE (user_id, device_token_hash)"
        bytea device_token_hash "SHA-256 của mã thiết bị ngẫu nhiên 32 byte do app hoặc trình duyệt giữ (cookie httpOnly hoặc secure storage); tách khỏi token phiên"
        text label "tên dễ nhận ra cho admin, vd Chrome trên Windows, iPhone của Lan; web suy từ user_agent, app gửi tên máy"
        text platform "web, android, ios (CHECK)"
        text user_agent "chuỗi gốc lúc thấy lần đầu, để điều tra; KHÔNG dùng để nhận diện"
        inet first_ip
        inet last_ip
        timestamptz first_seen_at
        timestamptz last_seen_at "cập nhật mỗi lần đăng nhập thành công"
        text status "CHECK: active, blocked; mặc định active; blocked = thiết bị bị chặn đăng nhập"
        uuid blocked_by FK "người chặn; NULL khi active"
        timestamptz blocked_at "NULL khi active"
        text block_note "bắt buộc khi blocked; CHECK (status = active OR (blocked_by IS NOT NULL AND blocked_at IS NOT NULL AND block_note IS NOT NULL)); mở chặn thì xóa ba cột, lịch sử ở auth_events và activity_logs"
    }

    login_approvals {
        uuid id PK "yêu cầu duyệt đăng nhập, mỗi lần xin một dòng; không xóa, không dọn theo thời gian"
        uuid user_id FK "tài khoản xin đăng nhập; không phải người duyệt (quy tắc l)"
        uuid device_id FK "NOT NULL; duyệt chỉ có giá trị cho đúng thiết bị này, không nhớ thiết bị cho lần sau"
        text kind "CHECK: first_login (lần đăng nhập đầu tiên của tài khoản), concurrent_session (đang có phiên sống ở thiết bị khác)"
        uuid blocking_session_id FK "phiên đang sống ở thiết bị khác lúc xin; CHECK ((kind = concurrent_session) = (blocking_session_id IS NOT NULL))"
        text status "CHECK: pending, approved, rejected, consumed, expired"
        timestamptz requested_at
        inet ip "IP lúc xin duyệt; hiện ở bảng chờ duyệt (MỚI v2.9)"
        timestamptz expires_at "requested_at + approval_valid_minutes; sau khi approved tính lại từ decided_at"
        uuid decided_by FK "người duyệt hoặc từ chối (approve_devices hoặc admin gốc); CHECK (status IN (pending, expired) OR decided_by IS NOT NULL)"
        timestamptz decided_at "NULL khi pending hoặc expired mà chưa ai quyết định"
        text decision_note "CHECK (status <> rejected OR decision_note IS NOT NULL)"
        uuid consumed_session_id FK "phiên được cấp nhờ yêu cầu này; CHECK ((status = consumed) = (consumed_session_id IS NOT NULL))"
    }

    login_exceptions {
        bigint id PK "ngoại lệ đăng nhập có thời hạn, CHỈ bỏ qua lịch ca (không bỏ khóa tài khoản, không bỏ duyệt đăng nhập); không xóa"
        uuid user_id FK "tài khoản được ngoại lệ; không phải chính người cấp (quy tắc l)"
        timestamptz valid_from "mặc định now()"
        timestamptz valid_until "NOT NULL; CHECK (valid_until > valid_from); tối đa 24 giờ kể từ valid_from (kiểm ở API)"
        text reason "NOT NULL; vd tăng ca, bù ca, sự cố"
        uuid granted_by FK "người cấp (manage_accounts hoặc admin gốc)"
        timestamptz granted_at
        timestamptz revoked_at "NULL = còn hiệu lực đến valid_until; có giá trị = thu hồi sớm"
        uuid revoked_by FK "NULL khi chưa thu hồi"
    }

    user_sessions {
        uuid id PK
        uuid user_id FK "UNIQUE (user_id) WHERE revoked_at IS NULL: mỗi tài khoản một phiên đang sống"
        uuid device_id FK "NOT NULL; thiết bị lúc cấp phiên (không bị blocked, và đã qua duyệt nếu thuộc trường hợp cần duyệt)"
        bytea token_hash UK "SHA-256 của token ngẫu nhiên 32 byte"
        timestamptz created_at "giờ đăng nhập"
        timestamptz last_seen_at "cập nhật tối đa một lần mỗi phút; dùng để tính không hoạt động (idle_timeout_minutes) và hiện cột Hoạt động cuối"
        timestamptz expires_at "hết hạn tuyệt đối = created_at + session_hours (mặc định 12 giờ, app_settings)"
        timestamptz revoked_at "giờ kết thúc phiên; phiên quá hạn thì job hoặc lần đăng nhập kế tiếp đặt = expires_at; phiên không hoạt động thì đặt = last_seen_at"
        text revoke_reason "CHECK: logout, logout_all, admin_revoke, employee_status, password_changed, account_locked, username_changed, expired, idle_timeout, device_replaced, device_blocked, shift_ended"
        inet ip
        text user_agent
    }

    auth_events {
        bigint id PK "chia PARTITION BY RANGE (occurred_at) theo tháng; khóa chính phải gồm cột chia partition: PRIMARY KEY (id, occurred_at)"
        timestamptz occurred_at PK "cột chia partition; thuộc khóa chính"
        citext username "tên đã nhập, kể cả sai hoặc không tồn tại"
        text event_type "CHECK: login_ok, login_failed, login_blocked, logout, logout_all, session_expired, session_revoked, password_changed, password_reset, account_locked, account_unlocked, username_changed, approval_requested, approval_approved, approval_rejected, device_blocked, device_unblocked"
        uuid user_id "không FK có chủ đích; null nếu tên không tồn tại"
        uuid session_id FK
        uuid device_id FK "nullable; thiết bị liên quan (null nếu tên không tồn tại hoặc chưa tới bước thiết bị)"
        inet ip
        text user_agent
        jsonb detail "vd account_locked: reason = manual hoặc failed_login; password_reset: by = user_id người đặt hoặc db_script; username_changed: old, new, by; session_expired và session_revoked: reason = theo revoke_reason, by nếu admin thu hồi; login_blocked: reason = employee_locked, manual_locked, failed_login_locked, outside_shift (kèm sub = outside_window hoặc shift_closed, window_start, window_end), device_blocked, approval_pending, approval_rejected, approval_limit; login_ok: via = exception hoặc open_shift nếu qua cổng lịch ca bằng đường đó, approval_id nếu nhờ duyệt"
    }

    activity_logs {
        bigint id PK
        timestamptz occurred_at
        uuid user_id FK "người thao tác; NULL = hệ thống hoặc trigger"
        uuid session_id FK "nullable; phiên đang dùng khi thao tác, để biết thao tác bằng thiết bị nào; NULL = hệ thống, trigger, script"
        text function_key FK "thao tác làm dưới chức năng nào (work_functions.key); NULL = thao tác quản trị hoặc hệ thống"
        text action "CHECK: create, update, delete, grant, revoke, assign, status_change, type_change, station_change, scope_change, account_lock, account_unlock, password_reset, username_change, open_shift, close_shift, force_close_shift, reopen_shift, revoke_session, login_unlock, login_approve, login_reject, device_block, device_unblock, schedule_assign, login_override; login_approve, login_reject, device_block, device_unblock giữ vĩnh viễn (không dọn)"
        text entity_type "luôn là tên bảng bị tác động, vd employees, users, employee_type_permissions, user_devices, login_approvals, employee_shift_schedules, login_exceptions (không dùng tên giao diện như account)"
        text entity_id "dạng text vì khóa có nhiều kiểu"
        text summary "câu tóm tắt hiển thị cho người xem"
        jsonb changes "giá trị cũ và mới theo từng cột; kèm lý do của lần lưu"
        inet ip
    }

    shifts {
        bigint id PK "ca làm của một tài khoản, có trạng thái; bản chốt bất biến nằm ở shift_reports"
        uuid user_id FK "NOT NULL; chủ ca (nhân viên hoặc admin gốc); UNIQUE (user_id, function_key) WHERE status = open"
        bigint employee_id FK "NULL khi chủ ca là admin gốc (trigger: NULL khi và chỉ khi users.is_root); còn lại là hồ sơ NV của chủ ca"
        text function_key FK "work_functions.key với has_shift = true; chủ ca phải đạt acting_context (nhân viên có quyền thuộc chức năng này; admin gốc luôn đạt)"
        bigint station_id FK "trạm làm ca, chọn lúc mở trong các trạm đang gán (người xem mọi trạm và admin gốc: mọi trạm active); v2.8 bắt buộc với mọi chức năng trừ shuttle_driver (tổng đài cũng chọn, mặc định trạm chính); shuttle_driver chụp trạm chính nếu có, không có thì NULL; CHECK (function_key = shuttle_driver OR station_id IS NOT NULL)"
        timestamptz opened_at "với shuttle_driver (auto_open) là lúc thao tác đầu tiên"
        timestamptz closed_at "null = đang mở"
        uuid closed_by FK "người đóng ca (chủ ca hoặc admin gốc); NULL khi đang mở"
        text close_reason "self hoặc admin; NULL khi đang mở; CHECK ((close_reason = self) = (closed_by = user_id))"
        text status "open, closed (CHECK); CHECK ((status = open) = (closed_at IS NULL AND closed_by IS NULL AND close_reason IS NULL))"
        text note
    }

    app_settings {
        text key PK "tham số hệ thống, mỗi tham số một dòng: early_login_minutes, late_grace_minutes, idle_timeout_minutes, session_hours, log_retention_months, approval_valid_minutes, approval_reject_cooldown_minutes, max_pending_approvals_per_user, login_schedule_timezone, failed_login_limit, failed_login_window_minutes (v2.9)"
        jsonb value "NOT NULL; số hoặc chuỗi theo từng khóa; API kiểm kiểu và biên"
        timestamptz updated_at
        uuid updated_by FK "chỉ admin gốc sửa; mỗi lần sửa ghi activity_logs entity_type app_settings, entity_id login_params"
    }

    %% ===== QUAN HỆ =====
    permission_groups ||--o{ permissions : "nhom quyen"
