    %% ===== KHUNG BẢNG MODULE KHÁC (chỉ để vẽ quan hệ; khớp tên với sơ đồ danh mục trạm, khu vực) =====
    station {
        bigint station_id PK "bảng thật thuộc module danh mục vận tải: region -> station -> stop_station; không có trạm chính hoặc trạm phụ"
        bigint region_id FK "NOT NULL; mỗi trạm thuộc một khu vực"
    }

    region {
        bigint region_id PK "bảng thật; khu vực của danh mục vận tải"
        text region_key UK "mã khu vực mà giao diện lưu và lọc (bản demo lưu mã dạng chữ)"
    }

    shift_reports {
        bigint id PK "bảng thật thuộc module kết ca (M05); chỉ ghi các cột liên quan đến nhân sự"
        bigint shift_id FK "ca được chốt; UNIQUE (shift_id, version)"
        int version "bản chốt chỉ ghi thêm, không sửa; mở lại ca rồi kết lại thì sinh version mới"
        text function_key FK "chụp từ shifts.function_key (call_center, ticket_office, cargo_receive, cargo_delivery, shuttle_driver); chia tab kết ca theo cột này"
        bigint employee_id FK "NULL nếu chủ ca là admin gốc; còn lại chụp hồ sơ NV của chủ ca"
        uuid closed_by FK "users.user_id người bấm kết ca; là admin gốc khi đóng thay"
        timestamptz closed_at "MỚI v2.8; NOT NULL; giờ bấm kết của version này; Tab 3 đến 6 lọc ngày và hiện Thời gian kết ca theo cột này; mở lại ca xóa shifts.closed_at nhưng cột này giữ nguyên"
        boolean is_forced "true = admin gốc đóng thay, các cột kiểm đếm thực tế (M05) để NULL; tab kết ca hiện nhãn Admin đóng"
        smallint employee_type_id FK "CHỤP loại NV của chủ ca tại lúc bấm, NULL nếu chủ ca là admin gốc; đổi loại sau không làm đổi dòng cũ; KHÔNG dùng để chia tab"
        bigint station_id FK "CHỤP trạm làm ca của shifts tại lúc bấm; NULL chỉ với shuttle_driver không có trạm; KHÔNG dùng để tính doanh thu theo trạm (lấy từ payments.station_id)"
    } 
