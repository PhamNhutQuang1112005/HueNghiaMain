    %% MÃ NHÂN VIÊN: employee_code = 'NV' + số thứ tự (tối thiểu 5 chữ số): NV00001, NV00002... Một dãy chung, KHÔNG theo loại. CHECK (employee_code ~ '^NV[0-9]{5,}$').
    %%   CREATE SEQUENCE employee_code_seq START 1. Trigger BEFORE INSERT: nếu employee_code NULL thì gán 'NV' || CASE WHEN n < 100000 THEN lpad(n::text, 5, '0') ELSE n::text END
