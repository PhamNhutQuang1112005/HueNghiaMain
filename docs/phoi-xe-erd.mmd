    %%       và khách / địa chỉ / loại khách ngẫu nhiên ở makeSeat (ticketstaff.js).
    %%   (14) NHẬT KÝ: FleetStore.log của phơi (entity trip: create, update, cancel, freeze, bulk-create; mới thấy ở Admin > Phơi xe và hủy phơi ở TicketStaff) ghi vào activity_logs (so-do-er-nhat-ky-v3.1.mermaid)
    %%       với entity_type = trip, entity_id = trip_id, changes = trước / sau. CHECK action của activity_logs hiện chưa có cancel, freeze, bulk_create, depart, reopen, reopen_close: đề xuất bổ sung ở file nhật ký (chưa sửa file đó).
    %%   (15) LOẠI XE - XE: khi gán xe, vehicle.vehicle_type_id phải bằng trip.vehicle_type_id. ĐÃ KHỚP CODE: FleetStore.plateMatchesType kiểm ở updateExistingTrip, saveAssign, adminSaveTrip (biển không còn trong danh sách xe = phơi cũ thì bỏ qua).
    %%       DB: FK ghép trip(vehicle_id, vehicle_type_id) -> vehicle(vehicle_id, vehicle_type_id), hoặc trigger. vehicle cần UNIQUE (vehicle_id, vehicle_type_id) làm đích cho FK ghép này,
    %%       và trip.vehicle_id chỉ trỏ xe scope line (CHECK / trigger).
    %% .
    %% ĐỂ SAU (GIAI ĐOẠN BOOKING) — những gì bị cắt khỏi bản này và điểm móc để gắn lại, để lúc làm booking không phải sửa lại bảng phơi:
    %%   Bảng làm sau: ticket, seat_cancellation, shuttle_assignment, pickup_request, agent, manifest_sales_total, manifest_denomination, manifest_roadside_guest, trip_violation, shift_closing, shift_closing_trip, shift_closing_expense, employee_stations.
    %%   Cột / quan hệ sẽ thêm vào bảng của bản này:
    %%     trip_seat ........... state (empty | hold | sold | free | cargo | hidden thay cho is_hidden nếu muốn), ticket_id (FK ghép (ticket_id, trip_id) -> ticket(ticket_id, trip_id)), locked / locked_by (BR-05, chưa có chức năng nên chưa tạo).
    %%     trip_manifest ....... orig_ticket_count, orig_passenger_count, orig_total_amount, orig_cash_amount, orig_transfer_amount, orig_paid_amount, orig_unpaid_amount, orig_station_ticket_count, orig_roadside_passenger_count (số liệu gốc đóng băng lúc khởi hành),
    %%                           advance_amount (tiền ứng), closed_at / closed_by (lần kết ca gần nhất), và giá trị manifest.status = MANIFEST_CLOSED (kết ca); khi đó Re-open cho phép mở từ cả MANIFEST_CLOSED.
    %%     trip_reopen_event ... tickets_added, passengers_added, amount_added, cash_added, transfer_added, paid_added, unpaid_added, station_ticket_added, roadside_passenger_added, settled_tickets, settled_amount.
    %%     Khác ................ trigger khóa bán sau khởi hành trên ticket / trip_seat; điều kiện 'chưa có khách' cho đổi loại xe và 'phơi trống' cho hủy phơi (quy tắc 3, 9); ticket.trip_id, ticket.reopen_event_id, ticket.settled_reopen_event_id;
    %%                           trip_violation.trip_id, shift_closing_trip.trip_id / reopen_event_id; legacy_trip_map dùng để nối dữ liệu seat bank / vé cũ vào trip_id mới.
    %%   Các quy tắc cũ của bản đầy đủ sẽ quay lại ở giai đoạn đó: bán vé (trạm bán, người thu tiền), ghế hủy và chuyển vé, mã vé ticket_no_seq, Rước liền / Trung chuyển, kết ca theo phần, thu bổ sung trong Re-open, vé nhiều ghế / giá ghế đôi.
    %%   Bản đầy đủ trước khi cắt được giữ ở phoi-xe-erd.full-booking.mmd.

    direction ||--o{ trip : "hướng của phơi (direction_id)"
    route |o--o{ trip : "tuyến đại diện để hiển thị (route_id); không quyết định phơi hiện ở tuyến nào"
    station |o--o{ trip : "trạm đi (from_station_id)"
    station |o--o{ trip : "trạm đến (to_station_id)"
    vehicle_type ||--o{ trip : "loại xe của phơi"
    vehicle_type ||--o{ vehicle : "loại xe của xe"
    vehicle |o--o{ trip : "xe được chỉ định (NULL = Chưa chỉ định)"
    employees |o--o{ trip : "tài xế tuyến (driver_id)"
    employees |o--o{ trip : "phụ xe (helper_id)"
    trip ||--o{ trip_pickup_station : "trạm có thể nhận thêm khách"
    station ||--o{ trip_pickup_station : ""

    trip ||--o{ trip_seat : "sơ đồ ghế"

    trip ||--o| trip_manifest : "phơi tạo lúc khởi hành (1-1)"
    trip_manifest ||--o{ trip_reopen_event : "các lần Re-open"

    %% ----- Tài khoản, phân quyền, nhật ký (khung; bảng đầy đủ ở so-do-er-nhan-su-v3.1.mermaid và so-do-er-nhat-ky-v3.1.mermaid) -----
    employees |o--o| users : "tài khoản đăng nhập (users.employee_id); admin gốc không có nhân viên"
    employee_types ||--o{ employees : "loại hiện tại"
    employee_types ||--o{ employee_type_permissions : "quyền của loại (nguồn duy nhất của quyền)"
    permissions ||--o{ employee_type_permissions : "quyền được cấp cho loại"
    permission_groups ||--o{ permissions : "nhóm quyền"
    users |o--o{ activity_logs : "người thao tác"
    users |o--o{ trip : "tạo / sửa / hủy phơi"
    users |o--o{ trip_manifest : "khởi hành / đóng băng"
    users |o--o{ trip_reopen_event : "mở / đóng Re-open"

    trip {
        bigint trip_id PK
        varchar name "tên hiển thị, mặc định = Trạm đi - Trạm đến (giờ)"
        date trip_date "NOT NULL; phơi mẫu luôn = hôm nay"
        time departure_time "NOT NULL, giờ xuất bến"
        bigint direction_id FK "NOT NULL; hướng của phơi (app: trip.directionId; phơi cũ suy từ nhãn tuyến)"
        bigint route_id FK "nullable; tuyến đại diện chỉ để hiển thị (app lưu nhãn tuyến dạng chuỗi trip.route)"
        bigint from_station_id FK "trạm đi; thuộc tỉnh đi của hướng (station.region_id = direction.from_region_id)"
        bigint to_station_id FK "trạm đến; thuộc tỉnh đến của hướng (station.region_id = direction.to_region_id)"
        bigint vehicle_type_id FK "NOT NULL, loại xe scope line. Giữ ở phơi vì phơi Chưa chỉ định (vehicle_id NULL) vẫn cần loại xe để sinh ghế và tra giá; khi gán xe, vehicle.vehicle_type_id phải bằng giá trị này"
        int base_price "giá ghế đơn của (trạm đi, trạm đến, loại xe) lấy tự động lúc lưu phơi; cặp chưa có giá thì nhân viên tự nhập; app: trip.price"
        bigint vehicle_id FK "nullable; NULL = Chưa chỉ định (BẮT BUỘC có giá trị khi khởi hành, quy tắc 4). DB chỉ giữ vehicle_id (app còn lưu chuỗi plate ở 2 nơi: trip.plate và tripSeatBank[tripId].plate)"
        bigint driver_id FK "nullable, employees.id có crew_role = route_driver (BẮT BUỘC có giá trị khi khởi hành, quy tắc 4); gắn theo phơi, không có mặc định (app đang lưu tên chuỗi ở tripSeatBank[tripId].driver)"
        bigint helper_id FK "nullable, employees.id có crew_role = helper; gắn theo phơi, không có mặc định (app đang lưu ở tripSeatBank[tripId].helper)"
        text note
        varchar status "NOT NULL DEFAULT open; open | cancelled (CHECK); cancelled chỉ đặt qua nút Hủy phơi. App lưu chuỗi: Chưa chỉ định | Đang bán | Khởi hành | Đã hủy (quy tắc 2)"
        text cancel_reason "bắt buộc khi status = cancelled (lý do gì)"
        timestamptz cancelled_at "bắt buộc khi status = cancelled (giờ nào); app: trip.cancelledAt"
        uuid cancelled_by FK "bắt buộc khi status = cancelled, users.user_id (hủy bởi ai); app: trip.cancelledBy = mã nhân viên"
        boolean is_template "NOT NULL DEFAULT FALSE; TRUE = phơi mẫu để nhân bản, không khởi hành được"
        timestamptz created_at
        uuid created_by FK "users.user_id: tài khoản tạo phơi; NOT NULL với phơi tạo mới, NULL = dữ liệu cũ. App CHƯA ghi (chỉ có createdAt dạng Date.now()): phải thêm vào createNewTrip, adminSaveTrip, adminBulkCreate"
        timestamptz updated_at
        uuid updated_by FK "users.user_id: người sửa gần nhất; NULL = chưa sửa hoặc dữ liệu cũ. App CHƯA ghi: thêm vào updateExistingTrip, adminSaveTrip"
    }

    trip_pickup_station {
        bigint trip_id PK, FK
        bigint station_id PK, FK "trạm có thể nhận thêm khách (pickupStations); thuộc tỉnh đi hoặc tỉnh đến của hướng"
    }

    trip_seat {
        bigint trip_seat_id PK
        bigint trip_id FK "NOT NULL, ON DELETE CASCADE"
        varchar seat_code "A1..An tầng dưới, B1..Bn tầng trên, mã ghế phụ / ghế dư; UNIQUE (trip_id, seat_code). App đang gắn hậu tố _hidden vào mã ghế ẩn: migrate bỏ hậu tố và đặt is_hidden = TRUE"
        varchar floor_type "NOT NULL; down | up | extra | sub (ghế phụ, chỉ có ghi chú và giá)"
        boolean is_hidden "NOT NULL DEFAULT FALSE; ghế ẩn của loại xe (vd A3, B3 của Limousine 34), không bán được"
        int price "giá niêm yết của ghế; mặc định DEFAULT_SUB_SEAT_PRICE cho ghế phụ. Khi làm booking: giá bán thật của ghế (free = 0)"
        text note "ghi chú của ghế phụ"
    }

    trip_manifest {
        bigint trip_id PK, FK "1-1 với trip, tạo đúng 1 lần lúc Khởi hành xe"
        varchar status "NOT NULL; DEPARTED | REOPEN | REOPEN_CLOSED (MANIFEST_CLOSED thêm ở giai đoạn kết ca)"
        varchar trip_label "chụp tiêu đề chuyến"
        date trip_date "chụp ngày"
        time departure_time "chụp giờ"
        varchar plate "chụp biển số lúc khởi hành; đổi xe sau KHÔNG cập nhật lại"
        varchar driver_name "chụp tài xế"
        varchar helper_name "chụp phụ xe"
        uuid created_by FK "NOT NULL với phơi mới, users.user_id: người bấm Khởi hành; NULL = dữ liệu cũ"
        timestamptz created_at "NOT NULL"
        timestamptz frozen_at "nullable; đặt khi nhân viên bấm Đóng băng ở màn Xem phơi (quy tắc 6); NOT NULL = phơi đã đóng băng, không Re-open nữa"
        uuid frozen_by FK "nullable, users.user_id; có khi frozen_at có giá trị"
    }

    trip_reopen_event {
        bigint reopen_event_id PK
        bigint trip_id FK "NOT NULL, trip_manifest.trip_id"
        int seq "NOT NULL, thứ tự lần Re-open; UNIQUE (trip_id, seq)"
        varchar status "NOT NULL; OPEN | CLOSED; tối đa 1 OPEN / phơi (UNIQUE (trip_id) WHERE status = OPEN)"
        text reason "lý do mở Re-open"
        timestamptz opened_at "NOT NULL"
        uuid opened_by FK "NOT NULL, users.user_id"
        timestamptz closed_at "có khi status = CLOSED"
        uuid closed_by FK "nullable, users.user_id"
    }

    direction {
        bigint direction_id PK "bảng đầy đủ ở route-erd.mmd"
    }

    route {
        bigint route_id PK "bảng đầy đủ ở route-erd.mmd"
    }

    station {
        bigint station_id PK "bảng đầy đủ ở station-erd.mmd"
    }

    vehicle_type {
        bigint vehicle_type_id PK
        varchar name "vd: Giường nằm 34 chỗ"
        int seats "số ghế dùng để sinh trip_seat"
        varchar scope "line | shuttle"
    }

    vehicle {
        bigint vehicle_id PK
        varchar plate UK "biển số"
        bigint vehicle_type_id FK
        varchar scope "line | shuttle"
        boolean active
    }

    employees {
        bigint id PK "bảng đầy đủ ở so-do-er-nhan-su-v3.1.mermaid; mọi nhân viên có hồ sơ, kể cả người không có tài khoản"
        smallint employee_type_id FK "NOT NULL; loại hiện tại, quyết định quyền và crew_role"
        text employee_code UK "NV00001; app lưu mã này (STAFF_CODE_MAP) ở các cột người thao tác, migrate đổi sang users.user_id"
        text full_name
        text phone_number
        text status_code FK "working | suspended | left | ...; trạng thái khóa tài khoản thì không đăng nhập được"
    }

    users {
        uuid user_id PK "tài khoản (so-do-er-nhan-su-v3.1); mọi cột người thao tác của sơ đồ này trỏ về đây. Các sơ đồ route / station / fare còn ghi bigint users.user_id, lệch v3.1 (uuid) cần thống nhất"
        bigint employee_id FK "UK; NULL chỉ khi is_root"
        boolean is_root "admin gốc: mọi quyền, không có hồ sơ nhân viên"
        citext username UK
        boolean is_active
    }

    employee_types {
        smallint id PK
        text code UK
        text name UK
        text crew_role "route_driver | shuttle_driver | helper | NULL: loại này được chọn làm tài xế tuyến / trung chuyển / phụ xe; KHÔNG quyết định quyền"
        boolean is_self "true = chỉ xem dữ liệu của chính mình"
    }

    employee_type_permissions {
        smallint employee_type_id PK, FK
        text permission_key PK, FK "có dòng = loại được cấp quyền; không dòng nào = loại 0 quyền; nguồn duy nhất của quyền người dùng"
    }

    permissions {
        text key PK "mã quyền, vd create_trip, edit_trip, delete_trip, assign_depart_reopen (ma trận ở quy tắc 12)"
        text group_key FK
        text label
    }

    permission_groups {
        text key PK "vd ticket_seat, trip_management, catalog_admin, accounting, hr_system"
        text label
    }

    activity_logs {
        bigint id PK "bảng đầy đủ ở so-do-er-nhat-ky-v3.1.mermaid"
        timestamptz occurred_at
        uuid user_id FK "người thao tác"
        text action "cần bổ sung cancel, freeze, bulk_create, depart, reopen, reopen_close (quy tắc 14)"
        text entity_type "trip, trip_manifest..."
        text entity_id
        jsonb changes "trước / sau"
    }
