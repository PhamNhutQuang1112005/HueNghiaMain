    trip ||--o{ ticket : "vé bán trên phơi (ticket.trip_id)"
    ticket |o--o{ trip_seat : "ghế thuộc vé; ghế đôi = 1 ghế, vé nhiều ghế = nhiều ghế"
    ticket ||--o{ seat_cancellation : "ghế đã hủy của vé"
    ticket |o--o| seat_cancellation : "vé mới tạo khi đặt lại vé hủy (restored_ticket_id)"
    ticket |o--o{ ticket : "vé được chuyển từ vé gốc (transferred_from_ticket_id)"
    ticket |o--o{ ticket : "vé đặt thêm cùng nhóm (group_ticket_id)"
    customer |o--o{ ticket : "khách hàng (customer_id), gán theo SĐT chính"
    agent |o--o{ ticket : "đại lý bán (agent_id)"
    station ||--o{ ticket : "trạm bán / trạm chịu doanh số (selling_station_id); admin gốc = trạm hệ thống Admin"
    station ||--o{ ticket : "trạm của người đặt (booked_station_id)"
    station |o--o{ ticket : "trạm đi lúc bán, dùng tra giá (from_station_id)"
    station |o--o{ ticket : "trạm đến lúc bán, dùng tra giá (to_station_id)"
    users ||--o{ ticket : "người bán / chịu doanh số (sold_by)"
    users ||--o{ ticket : "người đặt (booked_by)"
    trip_reopen_event |o--o{ ticket : "vé tạo trong lần Re-open (reopen_event_id)"
    trip_reopen_event |o--o{ ticket : "vé đặt trước, thu tiền trong lần Re-open (settled_reopen_event_id)"
    trip ||--o{ seat_cancellation : "phơi của ghế hủy"
    users ||--o{ seat_cancellation : "người hủy (cancelled_by)"

    pickup_request |o--o| ticket : "vé đã bán khi chỉ định xe (pickup_request.ticket_id); NULL = còn trong hàng chờ"
    users ||--o{ pickup_request : "người nhập khách Rước liền"
    station ||--o{ pickup_request : "trạm nơi nhập khách"
    ticket |o--o{ shuttle_assignment : "chặng đón / trả của vé (tối đa 1 dòng mỗi chặng)"
