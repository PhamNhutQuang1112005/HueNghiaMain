    employees ||--o{ employee_stations : "trạm làm việc (có lịch sử)"
    station ||--o{ employee_stations : "trạm được gán; is_primary = nguồn của ticket.selling_station_id"
    users |o--o{ activity_logs : "người thao tác (entity_type = ticket)"
    trip ||--o{ trip_seat : "sơ đồ ghế (phoi-xe-erd.mmd)"
