    %% ===================== CÁC BẢNG ĐẶT VÉ =====================
    ticket {
        bigint ticket_id PK "UNIQUE (ticket_id, trip_id)"
        bigint trip_id FK "NOT NULL; phơi của vé"
        varchar ticket_no "NOT NULL; SGCD-0001 từ ticket_no_seq; UNIQUE (ticket_no, trip_id) WHERE status IN (hold, sold)"
        varchar status "NOT NULL; hold | sold | cancelled | transferred"
        varchar channel "NOT NULL DEFAULT counter; counter | pickup (từ Rước liền)"
        bigint group_ticket_id FK "vé gốc của nhóm khi Đặt thêm cho nhóm"
        bigint transferred_from_ticket_id FK "vé nguồn khi chuyển ghế / đặt lại / đổi chỉ định"
        bigint customer_id FK "khách hàng, suy từ SĐT chính"
        varchar customer_name "NOT NULL; app: customerName"
        varchar phone "NOT NULL; SĐT chính chuẩn hoá; có index"
        text phone_extra "SĐT phụ (text[])"
        varchar guest_type "NOT NULL; Khách trạm | Trung chuyển | Rước đường; app: guestType"
        varchar first_stop "NOT NULL; app: firstStop"
        varchar last_stop "NOT NULL; app: lastStop"
        bigint from_station_id FK "trạm đi lúc bán, tra giá; app: fromStationId"
        bigint to_station_id FK "trạm đến lúc bán; app: toStationId"
        text pickup_address "app: transshipStation / transship / pickupAddress"
        text dropoff_address "app: arrivalTransfer / dropoffAddress"
        boolean has_luggage "NOT NULL DEFAULT FALSE; app: hasLuggage"
        text luggage_note "app: luggageNote"
        text note "app: note"
        int unit_price "NOT NULL >= 0; giá 1 ghế; app: price"
        boolean is_double_seat "NOT NULL DEFAULT FALSE; ghế đôi vẫn là 1 ghế"
        text zero_price_reason "bắt buộc khi unit_price = 0"
        int deposit_amount "NOT NULL DEFAULT 0; tổng cọc cả vé; app: depositAmount"
        varchar deposit_method "Tiền mặt | Chuyển khoản; app: depositMethod"
        varchar payment_method "Tiền mặt | Chuyển khoản; NOT NULL khi sold; app: paymentMethod"
        timestamptz sold_at "NOT NULL khi sold"
        bigint agent_id FK "đại lý; app: agentId"
        varchar agent_name "chụp tên đại lý; app: agentName"
        bigint selling_station_id FK "NOT NULL; trạm chịu doanh số; app: sellingStation"
        uuid sold_by FK "NOT NULL; người chịu doanh số / thu tiền; app: staff"
        bigint booked_station_id FK "NOT NULL; trạm người đặt; app: bookedStation"
        uuid booked_by FK "NOT NULL; người đặt; app: bookedBy"
        varchar sold_phase "NOT NULL; PRE_DEPART | POST_DEPART; app: soldPhase"
        bigint reopen_event_id FK "vé tạo lúc Re-open; app: reopenEventId"
        bigint settled_reopen_event_id FK "thu tiền lúc Re-open; app: settledReopenEventId"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL; app: actionTime"
    }

    trip_seat {
        bigint trip_seat_id PK "bảng đầy đủ ở phoi-xe-erd.mmd"
        bigint trip_id FK "NOT NULL"
        varchar seat_code "UNIQUE (trip_id, seat_code); app: code"
        varchar floor_type "down | up | extra | sub"
        boolean is_hidden "ghế ẩn của loại xe"
        int price "giá niêm yết ghế TRỐNG"
        bigint ticket_id FK "THÊM: NULL = ghế trống; FK ghép (ticket_id, trip_id)"
    }

    seat_cancellation {
        bigint cancellation_id PK "app: cancelledSeats[].id"
        bigint ticket_id FK "NOT NULL; vé gốc của ghế hủy"
        bigint trip_id FK "NOT NULL"
        varchar seat_code "NOT NULL; mỗi ghế hủy 1 dòng; app: code"
        varchar prev_status "hold | sold; chỉ hold mới đặt lại được; app: prevState"
        int unit_price "NOT NULL; giá ghế lúc hủy; app: price"
        text reason "NOT NULL; lý do hủy"
        timestamptz cancelled_at "NOT NULL; app: cancelledAt"
        uuid cancelled_by FK "users.user_id; app: cancelStaff"
        bigint restored_ticket_id FK "UNIQUE; vé mới khi đặt lại; app: restoredTo*"
    }

    customer {
        bigint customer_id PK
        varchar customer_code UK "KH0001..; từ hn_admin_customer_codes_v1"
        varchar phone UK "SĐT chính chuẩn hoá"
        varchar full_name "tên gần nhất"
        timestamptz created_at "NOT NULL"
    }

    agent {
        bigint agent_id PK "app: AgentStore id"
        varchar code UK "DL001.."
        varchar name UK
        varchar phone
        text note
    }

    pickup_request {
        bigint pickup_request_id PK "app: pickupPassengers[].id"
        varchar customer_name "NOT NULL; app: name"
        varchar phone "NOT NULL; SĐT chính chuẩn hoá (số đầu của collectPhoneValues)"
        text phone_extra "SĐT phụ (text[]); modal Rước liền cho nhập nhiều số, chuyển sang ticket.phone_extra khi chỉ định xe"
        int ticket_count "NOT NULL DEFAULT 1; app: ticketCount"
        varchar from_place "app: fromStation"
        text pickup_address "app: fromTransfer; '—' -> NULL"
        varchar to_place "app: toStation"
        text dropoff_address "app: toTransfer; '—' -> NULL"
        text note "app: note"
        bigint ticket_id FK "vé đã bán khi chỉ định xe; NULL = đang chờ; app: assigned"
        bigint station_id FK "trạm nhập khách"
        uuid created_by FK "users.user_id; ghi cả khi nhập từ Admin > Trung chuyển"
        date pickup_date "NOT NULL; ngày rước; app: date (Admin ghi, modal ticketstaff không ghi); mặc định ngày đang chọn ở danh sách Rước liền"
        timestamptz printed_at "giờ in danh sách Rước; app: printedAt (tính năng in chưa làm)"
        timestamptz created_at "app: createdAt"
    }

    shuttle_assignment {
        bigint assignment_id PK "app: hn_shuttle_driver_assign_v1"
        bigint ticket_id FK "đúng 1 trong ticket_id / pickup_request_id"
        bigint pickup_request_id FK "khách Rước liền còn chờ"
        varchar leg "NOT NULL; pickup | dropoff; app: hậu tố _don / _tra"
        bigint driver_id FK "employees, crew_role = shuttle_driver; app: driverName / driverPhone"
        bigint vehicle_id FK "xe scope shuttle; app: driverPlate"
        varchar status "NOT NULL DEFAULT waiting; waiting | enroute | onboard | issue"
        text issue_reason "bắt buộc khi issue; app: note"
        text driver_note "app: driverNote"
        text office_note "app: transshipPickupNote / transshipDropoffNote"
        timestamptz updated_at "NOT NULL"
        uuid updated_by FK "users.user_id"
    }

    employee_stations {
        bigint id PK "đầy đủ ở so-do-er-nhan-su-v3.1"
        bigint employee_id FK
        bigint station_id FK
        boolean is_primary "nguồn của ticket.selling_station_id"
        timestamptz valid_to "NULL = đang áp dụng"
    }

    trip {
        bigint trip_id PK "KHUNG, đầy đủ ở phoi-xe-erd.mmd"
    }

    trip_reopen_event {
        bigint reopen_event_id PK "KHUNG, đầy đủ ở phoi-xe-erd.mmd"
    }

    station {
        bigint station_id PK "KHUNG; cần dòng hệ thống Admin"
    }

    users {
        uuid user_id PK "KHUNG, so-do-er-nhan-su-v3.1"
    }

    employees {
        bigint id PK "KHUNG, so-do-er-nhan-su-v3.1"
    }

    vehicle {
        bigint vehicle_id PK "KHUNG"
    }

    activity_logs {
        bigint id PK "KHUNG, so-do-er-nhat-ky-v3.1"
        text entity_type "ticket, pickup_request..."
        text entity_id
        text action "book, sell, edit, cancel_seat, transfer, restore..."
    }

