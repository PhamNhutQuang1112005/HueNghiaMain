    trip {
        bigint trip_id PK
        varchar name "tên hiển thị, mặc định = Trạm đi - Trạm đến (giờ)"
        date trip_date "NOT NULL; phơi mẫu luôn = hôm nay"
        time departure_time "NOT NULL, giờ xuất bến"
        bigint direction_id FK "NOT NULL; hướng của phơi (app: trip.directionId; phơi cũ suy từ nhãn tuyến)"
        bigint route_id FK "nullable; tuyến đại diện chỉ để hiển thị (app lưu nhãn tuyến dạng chuỗi trip.route)"
        bigint from_station_id FK "trạm đi; thuộc tỉnh đi của hướng (station.region_id = direction.from_region_id)"
        bigint to_station_id FK "trạm đến; thuộc tỉnh đến của hướng (station.region_id = direction.to_region_id)"
        bigint vehicle_type_id FK "NOT NULL, loại xe scope line. Giữ ở phơi vì phơi Chưa chỉ định (vehicle_id NULL) vẫn cần loại xe để sinh ghế và tra giá; khi gán xe, vehicle.vehicle_type_id phải bằng giá trị này"
        int base_price "giá ghế đơn của (trạm đi, trạm đến, loại xe) lấy tự động lúc lưu phơi; cặp chưa có giá thì nhân viên tự nhập; app: trip.price"
        bigint vehicle_id FK "nullable; NULL = Chưa chỉ định (BẮT BUỘC có giá trị khi khởi hành, quy tắc 4). DB chỉ giữ vehicle_id (app còn lưu chuỗi plate ở 2 nơi: trip.plate và tripSeatBank[tripId].plate)"
        bigint driver_id FK "nullable, employees.id có crew_role = route_driver (BẮT BUỘC có giá trị khi khởi hành, quy tắc 4); gắn theo phơi, không có mặc định (app đang lưu tên chuỗi ở tripSeatBank[tripId].driver)"
        bigint helper_id FK "nullable, employees.id có crew_role = helper; gắn theo phơi, không có mặc định (app đang lưu ở tripSeatBank[tripId].helper)"
        text note
        varchar status "NOT NULL DEFAULT open; open | cancelled (CHECK); cancelled chỉ đặt qua nút Hủy phơi và chỉ khi phơi trống. App lưu chuỗi: Chưa chỉ định | Đang bán | Khởi hành | Đã hủy (quy tắc 2)"
        text cancel_reason "bắt buộc khi status = cancelled (lý do gì)"
        timestamptz cancelled_at "bắt buộc khi status = cancelled (giờ nào); app: trip.cancelledAt"
        uuid cancelled_by FK "bắt buộc khi status = cancelled, users.user_id (hủy bởi ai); app: trip.cancelledBy = mã nhân viên"
        boolean is_template "NOT NULL DEFAULT FALSE; TRUE = phơi mẫu để nhân bản, không bán vé"
        timestamptz created_at
        uuid created_by FK "users.user_id: tài khoản tạo phơi; NOT NULL với phơi tạo mới, NULL = dữ liệu cũ. App CHƯA ghi (chỉ có createdAt dạng Date.now()): phải thêm vào createNewTrip, adminSaveTrip, adminBulkCreate"
        timestamptz updated_at
        uuid updated_by FK "users.user_id: người sửa gần nhất; NULL = chưa sửa hoặc dữ liệu cũ. App CHƯA ghi: thêm vào updateExistingTrip, adminSaveTrip"
    }

    trip_pickup_station {
        bigint trip_id PK, FK
        bigint station_id PK, FK "trạm có thể nhận thêm khách (pickupStations); thuộc tỉnh đi hoặc tỉnh đến của hướng"
    }

    trip_seat {
        bigint trip_seat_id PK
        bigint trip_id FK "NOT NULL, ON DELETE CASCADE"
        varchar seat_code "A1..An tầng dưới, B1..Bn tầng trên, mã ghế phụ / ghế dư; UNIQUE (trip_id, seat_code). Ghế ẩn của loại xe (vd A3, B3 của Limousine 34) lưu state = hidden (app đang gắn hậu tố _hidden vào mã)"
        varchar floor_type "NOT NULL; down | up | extra | sub (ghế phụ, chỉ có ghi chú và giá)"
        varchar state "NOT NULL DEFAULT empty; empty | hold | sold | free | cargo | hidden"
        int price "giá bán của ghế; free = 0, mặc định DEFAULT_SUB_SEAT_PRICE cho ghế phụ"
        bigint ticket_id FK "nullable, NULL = ghế trống; ghế liền kề cùng vé trỏ chung 1 ticket_id; FK ghép (ticket_id, trip_id) -> ticket(ticket_id, trip_id) để ghế không trỏ sang vé của phơi khác"
        boolean locked "NOT NULL DEFAULT FALSE, khoá tạm thời (BR-05). CHƯA CÓ chức năng: app không có nơi nào đặt khoá thật (chỉ ghế demo ở ticketstaff.js); giữ cột nếu sẽ làm BR-05, không thì bỏ"
        varchar locked_by "nhân viên đang khoá (chưa dùng, như cột locked)"
        text note "ghi chú của ghế phụ"
    }

    ticket {
        bigint ticket_id PK "UNIQUE (ticket_id, trip_id) làm đích cho FK ghép của trip_seat"
        bigint trip_id FK "NOT NULL"
        varchar ticket_no "mã vé SGCD-0001 cấp bằng SEQUENCE ticket_no_seq; UNIQUE (ticket_no, trip_id) WHERE status = active, KHÔNG unique toàn hệ thống (quy tắc 14); app gom ghế thành vé theo ticketNo"
        bigint transferred_from_ticket_id FK "nullable; vé gốc (đã hủy hoặc còn một phần) mà vé này được chuyển từ (quy tắc 13); vé này luôn có ticket_no mới (quy tắc 21, 22), trừ trường hợp đặt lại vé hủy đúng ghế cũ trong đúng phơi cũ thì dùng lại mã vé hủy (quy tắc 13)"
        varchar status "NOT NULL DEFAULT active; active | cancelled | transferred (CHECK); cancelled khi mọi ghế của vé đã hủy (quy tắc 13); transferred khi vé đã chuyển hết ghế sang vé mới (quy tắc 21, 22); vé cũ trên app suy từ seat_cancellation"
        varchar customer_name
        varchar phone "có index; dùng tra lịch sử khách và nối chặng đón trung chuyển"
        varchar guest_type "NOT NULL DEFAULT Khách trạm; Khách trạm | Trung chuyển | Rước đường. Khách từ hàng chờ Rước liền sau khi chỉ định xe lưu là Trung chuyển (nguồn gốc nối qua pickup_request.ticket_id, quy tắc 18); dữ liệu cũ có thể còn giá trị Rước liền"
        varchar first_stop "điểm đi (chụp tên trạm / điểm dừng lúc bán)"
        varchar last_stop "điểm đến"
        bigint from_station_id FK "nullable; trạm đi lúc bán, dùng tra giá (app: ticket.fromStationId)"
        bigint to_station_id FK "nullable; trạm đến lúc bán (app: ticket.toStationId)"
        boolean is_double_seat "NOT NULL DEFAULT FALSE; vé tính giá ghế đôi (app: ticket.isDoubleSeat)"
        int deposit_amount "NOT NULL DEFAULT 0; tiền cọc, không lớn hơn giá vé"
        varchar deposit_method "Tiền mặt | Chuyển khoản; có khi deposit_amount > 0"
        text zero_price_reason "bắt buộc khi giá vé = 0đ"
        text pickup_address "địa chỉ đón (trung chuyển / rước đường); gộp các field app transshipStation / transship / pickupAddress / fromTransfer"
        text dropoff_address "địa chỉ trả; gộp các field app arrivalTransfer / dropoffAddress"
        varchar pickup_time
        varchar call_state "Chưa gọi | ... (trạng thái gọi khách)"
        boolean paid "NOT NULL DEFAULT FALSE; thu tiền hay chưa"
        varchar payment_method "Tiền mặt | Chuyển khoản"
        boolean has_luggage
        text luggage_note
        text note
        bigint selling_station_id FK "NOT NULL; trạm chính của nhân viên thao tác lúc bán (staff.station), admin gốc = trạm hệ thống Admin (quy tắc 12), chụp 1 lần lúc tạo vé, không chọn tay, không đổi khi sửa (quy tắc 12); app: seat.sellingStation lưu TÊN trạm"
        varchar sold_phase "NOT NULL; PRE_DEPART | POST_DEPART (bán trước / sau khởi hành)"
        bigint reopen_event_id FK "nullable, chỉ có khi TẠO vé lúc phơi đang Re-open"
        bigint booked_station_id FK "nullable; trạm của người ĐẶT vé (app: seat.bookedStation), chụp lúc đặt; vé tạo thẳng ở trạng thái bán thì bằng selling_station_id"
        bigint settled_reopen_event_id FK "nullable; lần Re-open mà vé ĐẶT từ trước được THU TIỀN (app: seat.settledReopenEventId, đặt trong tsStampSeller). Dùng để ghi doanh thu thu bổ sung vào đúng lần Re-open (quy tắc 5)"
        bigint agent_id FK "nullable, đại lý (tick Đại lý)"
        varchar agent_name "chụp tên đại lý lúc đặt, giữ khi đại lý bị xoá"
        uuid sold_by FK "NOT NULL; users.user_id: tài khoản THU TIỀN / bán vé (admin gốc bán thì là tài khoản admin); vé cũ thiếu người bán migrate = admin gốc; vé đặt (hold) tạm mang người đặt / người chuyển gần nhất, đổi thành người bán khi vé sold; app: seat.staff = mã nhân viên (vé cũ có thể thiếu, hiển thị 'Không rõ'); thống kê theo nhân viên đi qua users.employee_id"
        uuid booked_by FK "nullable; users.user_id người ĐẶT vé (app: seat.bookedBy); vé cũ thiếu thì lấy theo sold_by"
        timestamptz created_at
        timestamptz updated_at
    }

    seat_cancellation {
        bigint cancellation_id PK
        bigint ticket_id FK "nullable (dữ liệu cũ không có mã vé); vé gốc của ghế đã hủy, dòng vé được giữ lại"
        bigint trip_id FK "NOT NULL"
        varchar seat_code "NOT NULL, ghế đã hủy"
        varchar ticket_no "bản chụp mã vé lúc hủy (app lưu ticketNo dạng chuỗi); khi ticket_id có giá trị thì lấy theo vé"
        varchar customer_name
        varchar phone
        varchar first_stop
        varchar last_stop
        int price
        text reason "NOT NULL, lý do hủy bắt buộc"
        varchar prev_state "trạng thái ghế lúc hủy (app: prevState); hold = ghế đã đặt, được chuyển sang phơi khác; sold / free / cargo = không chuyển được; NULL = bản ghi cũ"
        timestamptz cancelled_at "app: cancelledAt (ISO); cancelTime chỉ là chuỗi hiển thị"
        uuid cancelled_by FK "nullable, users.user_id; app: cancelStaff = mã nhân viên"
        text note
        boolean restored "NOT NULL DEFAULT FALSE; TRUE = vé hủy đã được chuyển sang ghế khác (app: restored)"
        bigint restored_to_trip_id FK "nullable, trip.trip_id phơi nhận vé"
        varchar restored_to_seat_code "nullable, ghế nhận vé"
        timestamptz restored_at
        uuid restored_by FK "nullable, users.user_id"
    }

    shuttle_assignment {
        bigint assignment_id PK
        bigint ticket_id FK "nullable; vé đã có ghế (khách Trung chuyển / Rước đường, hoặc khách Rước liền sau khi đã chỉ định xe)"
        bigint pickup_request_id FK "nullable; khách Rước liền còn trong hàng chờ, chưa có ghế. CHECK đúng 1 trong 2 cột ticket_id / pickup_request_id có giá trị; khi Rước liền thành vé thì chuyển dòng sang ticket_id (quy tắc 18)"
        varchar leg "NOT NULL; pickup | dropoff (app: hậu tố _don / _tra của khoá sđt). UNIQUE (ticket_id, leg) WHERE ticket_id IS NOT NULL và UNIQUE (pickup_request_id, leg) WHERE pickup_request_id IS NOT NULL. Không bắt buộc: chưa phân tài xế thì không có dòng"
        bigint driver_id FK "nullable, employees.id có crew_role = shuttle_driver (app: driverName + driverPhone, khớp theo SĐT)"
        bigint vehicle_id FK "nullable, xe scope shuttle (app: driverPlate + driverVehicleType)"
        varchar status "NOT NULL DEFAULT waiting; waiting | enroute | onboard | issue"
        text issue_reason "bắt buộc khi status = issue (app: entry.note, mặc định Không liên lạc được)"
        text driver_note "ghi chú của tài xế trung chuyển (app: driverNote)"
        text office_note "ghi chú phòng vé của dòng gắn vé; khách chờ Rước liền dùng pickup_request.office_note"
        timestamptz updated_at
        uuid updated_by FK "nullable, users.user_id"
    }

    trip_manifest {
        bigint trip_id PK, FK "1-1 với trip, tạo đúng 1 lần lúc Khởi hành xe"
        varchar status "NOT NULL; DEPARTED | REOPEN | REOPEN_CLOSED | MANIFEST_CLOSED"
        varchar trip_label "chụp tiêu đề chuyến"
        date trip_date "chụp ngày"
        time departure_time "chụp giờ"
        varchar plate "chụp biển số lúc khởi hành; đổi xe sau KHÔNG cập nhật lại"
        varchar driver_name "chụp tài xế"
        varchar helper_name "chụp phụ xe"
        int advance_amount "NOT NULL DEFAULT 0, tiền ứng"
        int orig_ticket_count "số liệu phơi GỐC (bán trước khởi hành), đóng băng"
        int orig_passenger_count
        int orig_total_amount
        int orig_cash_amount
        int orig_transfer_amount
        int orig_paid_amount "tổng tiền ghế sold"
        int orig_unpaid_amount "tổng tiền ghế hold / free / cargo"
        int orig_station_ticket_count "vé Khách trạm + Trung chuyển, đếm theo vé"
        int orig_roadside_passenger_count "khách Rước đường, đếm theo hành khách"
        uuid created_by FK "NOT NULL với phơi mới, users.user_id; điều kiện gom vào kết ca (quy tắc 6); NULL = dữ liệu cũ"
        timestamptz created_at "NOT NULL"
        timestamptz closed_at "có khi MANIFEST_CLOSED; lần kết ca gần nhất (quy tắc 25c)"
        uuid closed_by FK "nullable, users.user_id"
        timestamptz frozen_at "nullable; đặt khi nhân viên bấm Đóng băng ở màn Xem phơi và ghi bản chụp manifest_denomination (quy tắc 15); NOT NULL = phơi đã đóng băng, không Re-open nữa"
        uuid frozen_by FK "nullable, users.user_id; có khi frozen_at có giá trị"
    }

    trip_reopen_event {
        bigint reopen_event_id PK
        bigint trip_id FK "NOT NULL, trip_manifest.trip_id"
        int seq "NOT NULL, thứ tự lần Re-open; UNIQUE (trip_id, seq)"
        varchar status "NOT NULL; OPEN | CLOSED; tối đa 1 OPEN / phơi"
        text reason "lý do mở Re-open"
        timestamptz opened_at "NOT NULL"
        uuid opened_by FK "NOT NULL, users.user_id"
        timestamptz closed_at
        uuid closed_by FK "nullable, users.user_id"
        int tickets_added "đóng băng lúc đóng Re-open"
        int passengers_added
        int amount_added
        int cash_added
        int transfer_added
        int paid_added
        int unpaid_added
        int station_ticket_added
        int roadside_passenger_added
        int settled_tickets "số vé ĐẶT trước được thu tiền trong lần Re-open này (tsApplyReopenSettlements), đóng băng lúc đóng"
        int settled_amount "tổng tiền các vé thu bổ sung đó; KHÔNG nằm trong tickets_added / amount_added vì vé đã được đếm ở phần gốc / Re-open trước"
    }

    manifest_sales_total {
        bigint id PK
        bigint trip_id FK "NOT NULL"
        bigint reopen_event_id FK "nullable, NULL = phơi gốc, có giá trị = lần Re-open"
        bigint station_id FK "NOT NULL, trạm của nhân viên thao tác lúc bán (chụp lúc bán); admin gốc = trạm hệ thống Admin"
        uuid seller_user_id FK "NOT NULL, users.user_id: tài khoản bán vé (ticket.sold_by); nhân viên của họ là users.employee_id"
        int tickets "NOT NULL DEFAULT 0; có thể ÂM ở dòng của lần Re-open (thu bổ sung trừ khỏi người đặt / trạm đặt)"
        int passengers "NOT NULL DEFAULT 0; có thể âm như trên"
        int amount "NOT NULL DEFAULT 0, có thể âm như trên; chống trùng bằng 2 unique index một phần: (trip_id, station_id, seller_user_id) WHERE reopen_event_id IS NULL và (trip_id, reopen_event_id, station_id, seller_user_id) WHERE reopen_event_id IS NOT NULL (UNIQUE thường không chặn trùng khi cột là NULL)"
    }

    manifest_denomination {
        bigint id PK
        bigint trip_id FK "NOT NULL, trip_manifest.trip_id; chỉ có dòng sau khi trip_manifest.frozen_at được đặt"
        bigint station_id FK "NOT NULL, trạm bán"
        varchar kind "NOT NULL; fare (vé có giá) | free (vé 0đ) | roadside (khách Rước đường)"
        int price "NOT NULL DEFAULT 0; mệnh giá cho kind = fare, 0 cho free / roadside"
        int ticket_count "NOT NULL DEFAULT 0, đếm theo vé"
        int amount "NOT NULL DEFAULT 0; UNIQUE (trip_id, station_id, kind, price)"
    }

    manifest_roadside_guest {
        bigint id PK
