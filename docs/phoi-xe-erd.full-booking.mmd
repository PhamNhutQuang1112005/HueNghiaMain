    trip_violation {
        bigint violation_id PK
        bigint trip_id FK "NOT NULL"
        varchar trip_label
        varchar driver_name
        int on_manifest_count "số khách trên phơi"
        int actual_count "số khách kiểm tra thực tế"
        int diff_count "CHECK = actual_count - on_manifest_count"
        varchar checker "NOT NULL, người kiểm tra"
        uuid recorded_by FK "users.user_id: tài khoản nhập bản ghi (checker là tên người kiểm tra gõ tay, có thể không phải nhân viên); NULL = dữ liệu cũ. App CHƯA ghi cột này (confirmViolation chưa lưu người nhập): cần thêm"
        timestamptz checked_at "NOT NULL"
        text note
        int penalty_amount "NOT NULL DEFAULT 0, tiền phạt"
        varchar status "NOT NULL DEFAULT Chưa xử lý; CHECK: Chưa xử lý | Đã xử lý | Đã miễn phạt (ô violationStatusSelect). penalty_amount hiện chỉ ghi nhận; chốt sẽ đẩy sang kế toán như một khoản thu riêng (CHƯA làm vì kế toán chưa liên quan tới phơi xe)"
